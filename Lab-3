fun powerFor(a: Int, b: Int): Int {
    var result = 1
    for (i in 1..b) {
        result *= a
    }
    return result
}

fun powerWhile(a: Int, b: Int): Int {
    var result = 1
    var i = 1
    while (i <= b) {
        result *= a
        i++
    }
    return result
}

fun powerRepeat(a: Int, b: Int): Int {
    var result = 1
    repeat(b) {
        result *= a
    }
    return result
}

data class Operation(val a: Int, val b: Int, val operator: String)

fun fib(n: Int) {
    var first = 1
    var second = 1

    if (n >= 1) print("$first ")
    if (n >= 2) print("$second ")

    for (i in 3..n) {
        val next = first + second
        print("$next ")
        first = second
        second = next
    }
}

fun printArray(arr: IntArray) {
    for (num in arr) {
        print("$num ")
    }
    println()
}

fun insertionSort(arr: IntArray) {
    for (i in 1 until arr.size) {
        val key = arr[i]
        var j = i - 1

        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j]
            j--
        }

        arr[j + 1] = key
    }
}

fun bubbleSort(arr: IntArray) {
    for (i in 0 until arr.size - 1) {
        for (j in 0 until arr.size - 1 - i) {
            if (arr[j] > arr[j + 1]) {
                val temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
        }
    }
}

open class Animal(val name: String, val age: Int, val species: String) {

    open fun move() {
        println("$name is moving.")
    }

    override fun toString(): String {
        return "Hi. I'm a $species. I'm $age years old and my name is $name."
    }
}

class Fish(name: String, age: Int, species: String) : Animal(name, age, species) {
    override fun move() {
        println("$name is swimming.")
    }
}

class Dog(name: String, age: Int, species: String) : Animal(name, age, species) {
    override fun move() {
        println("$name is running.")
    }
}


